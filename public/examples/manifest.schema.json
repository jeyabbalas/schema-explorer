{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema Explorer example manifest",
  "description": "Describes the example schema sets bundled under public/examples/. Generated by scripts/sync-examples.ts.",
  "type": "object",
  "required": ["version", "source", "groups"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["name", "url", "license", "copyright", "licenseFile"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "copyright": { "type": "string" },
        "licenseFile": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "name", "description", "sourcePath", "bytes", "files", "datasets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "sourcePath": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "bytes"],
              "properties": {
                "path": { "type": "string", "pattern": "^[^/\\s][^\\s]*\\.json$" },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "datasets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["root", "title", "variables", "categories"],
              "properties": {
                "root": { "type": "string" },
                "title": { "type": "string" },
                "variables": { "type": "integer", "minimum": 0 },
                "categories": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
