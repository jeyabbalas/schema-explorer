{
  "name": "schema-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Explore and search several JSON Schema data dictionaries at once, entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Jeya Balaji Balasubramanian",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeyabbalas/schema-explorer.git"
  },
  "homepage": "https://jeyabbalas.github.io/schema-explorer/",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-examples": "node scripts/sync-examples.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "json-schema-data-dictionary": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
